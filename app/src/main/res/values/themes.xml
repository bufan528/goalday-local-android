<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.GoaldayLocal" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="WidgetScheduleTask">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#3A342E</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="WidgetScheduleRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">7dp</item>
        <item name="android:background">@drawable/widget_schedule_row_background</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingLeft">9dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingRight">9dp</item>
        <item name="android:paddingBottom">7dp</item>
    </style>

    <style name="WidgetScheduleDot">
        <item name="android:layout_width">16dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:text">●</item>
        <item name="android:textColor">#E88FAE</item>
        <item name="android:textSize">10sp</item>
    </style>
</resources>
