<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_schedule_background"
    android:orientation="vertical"
    android:padding="15dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Goalday 今日"
                android:textColor="#2F2922"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="#8B7A68"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_status_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_schedule_status_background"
            android:paddingLeft="10dp"
            android:paddingTop="5dp"
            android:paddingRight="10dp"
            android:paddingBottom="5dp"
            android:textColor="#B45E7A"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/widget_schedule_empty_background"
        android:padding="12dp"
        android:text="今天还没有日程\n从目标页把任务排进今天，桌面会自动刷新"
        android:textColor="#8B7A68"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_section_today"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="TODAY"
        android:textColor="#B45E7A"
        android:textSize="10sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/widget_row_1"
        style="@style/WidgetScheduleRow">

        <TextView
            android:id="@+id/widget_dot_1"
            style="@style/WidgetScheduleDot" />

        <TextView
            android:id="@+id/widget_task_1"
            style="@style/WidgetScheduleTask" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row_2"
        style="@style/WidgetScheduleRow">

        <TextView
            android:id="@+id/widget_dot_2"
            style="@style/WidgetScheduleDot" />

        <TextView
            android:id="@+id/widget_task_2"
            style="@style/WidgetScheduleTask" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row_3"
        style="@style/WidgetScheduleRow">

        <TextView
            android:id="@+id/widget_dot_3"
            style="@style/WidgetScheduleDot" />

        <TextView
            android:id="@+id/widget_task_3"
            style="@style/WidgetScheduleTask" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row_4"
        style="@style/WidgetScheduleRow">

        <TextView
            android:id="@+id/widget_dot_4"
            style="@style/WidgetScheduleDot" />

        <TextView
            android:id="@+id/widget_task_4"
            style="@style/WidgetScheduleTask" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row_5"
        style="@style/WidgetScheduleRow">

        <TextView
            android:id="@+id/widget_dot_5"
            style="@style/WidgetScheduleDot" />

        <TextView
            android:id="@+id/widget_task_5"
            style="@style/WidgetScheduleTask" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:text="点击打开日程手账"
        android:textColor="#A58B73"
        android:textSize="11sp" />
</LinearLayout>
