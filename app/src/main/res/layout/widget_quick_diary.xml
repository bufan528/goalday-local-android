<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_diary_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_schedule_background">

    <TextView
        android:id="@+id/quick_diary_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="记录今天"
        android:textColor="#2F2922"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/quick_diary_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#8B7A68"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/quick_diary_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/widget_quick_diary_button"
        android:paddingLeft="12dp"
        android:paddingTop="6dp"
        android:paddingRight="12dp"
        android:paddingBottom="6dp"
        android:text="写日记"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
